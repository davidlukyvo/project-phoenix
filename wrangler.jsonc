// production-domain: sangvo.me
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "project-phoenix",
  "compatibility_date": "2026-08-20",
  "workers_dev": false,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "sangvo.me",
      "custom_domain": true
    }
  ],
  "observability": { "enabled": true },
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  }
}
